# Шаблон для будущих этапов; чтение настроек приложением появится в T-03.
# Копируйте в .env без перезаписи существующего файла. Настоящие секреты — только в .env.
APP_ENV=dev
LOG_LEVEL=INFO

# Локальная PostgreSQL 17; пароль заполните самостоятельно перед запуском БД.
POSTGRES_DB=skinulis
POSTGRES_USER=skinulis
POSTGRES_PASSWORD=
# Вставьте тот же локальный пароль в URL, экранируя специальные символы (URL encoding).
DATABASE_URL=postgresql+psycopg://skinulis:<local-password>@localhost:5432/skinulis

# Будущий HTTP-клиент Telegram-бота; локальный API из T-03.
API_BASE_URL=http://localhost:8000
# Разные значения для Telegram Bot API, bot-service запросов и подписи JWT.
TELEGRAM_BOT_TOKEN=
BOT_SERVICE_TOKEN=
JWT_SECRET_KEY=
