# Копируйте в .env без перезаписи существующего файла. Настоящие секреты — только в .env.
APP_ENV=dev
LOG_LEVEL=INFO

# Локальная PostgreSQL 17; пароль заполните самостоятельно перед запуском БД.
POSTGRES_DB=skinulis
POSTGRES_USER=skinulis
POSTGRES_PASSWORD=
# Для локального процесса API (Compose сам использует db:5432, порт БД не публикуется).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Необязательный полный URL для локального API/Alembic; при заполнении имеет приоритет.
# Например postgresql+psycopg://skinulis:<url-encoded-local-password>@localhost:5432/skinulis
# В Compose подключение собирается из POSTGRES_* с безопасным экранированием пароля.
DATABASE_URL=
# HTTP-порт API на loopback хоста; порт внутри Docker всегда 8000.
API_PORT=8000
# Необязательный настоящий 40-символьный SHA для Docker build; пусто => commit_sha: null.
APP_COMMIT_SHA=

# Будущий HTTP-клиент Telegram-бота; локальный API из T-03.
API_BASE_URL=http://localhost:8000
# Разные значения для Telegram Bot API, bot-service запросов и подписи JWT.
TELEGRAM_BOT_TOKEN=
BOT_SERVICE_TOKEN=
JWT_SECRET_KEY=
