{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartOnlyOnProductionInstance",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:ap-southeast-2:<AWS_ACCOUNT_ID>:instance/<INSTANCE_ID>",
      "Condition": {
        "BoolIfExists": {
          "ssm:SessionDocumentAccessCheck": "true"
        }
      }
    },
    {
      "Sid": "AllowOnlyAwsSshDocument",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ssm:ap-southeast-2::document/AWS-StartSSHSession"
    },
    {
      "Sid": "OpenSessionDataStream",
      "Effect": "Allow",
      "Action": "ssmmessages:OpenDataChannel",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "EndOnlyOwnSessionsOnProductionInstance",
      "Effect": "Allow",
      "Action": "ssm:TerminateSession",
      "Resource": "arn:aws:ssm:ap-southeast-2:<AWS_ACCOUNT_ID>:session/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/aws:ssmmessages:target-id": "<INSTANCE_ID>",
          "ssm:resourceTag/aws:ssmmessages:session-id": "${aws:userid}"
        }
      }
    }
  ]
}
