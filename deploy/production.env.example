# VPS-only file outside release bundles, mode 0600. Never commit filled values.
COMPOSE_PROJECT_NAME=skinulis-production
PUBLIC_DOMAIN=
POSTGRES_VOLUME=skinulis-production-postgres
POSTGRES_DB=skinulis
POSTGRES_USER=skinulis
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
BOT_SERVICE_TOKEN=
# Required only for an explicitly authorized --enable-polling deployment.
TELEGRAM_BOT_TOKEN=
# APP_IMAGE is supplied by the deploy runner as a verified image@sha256 digest.
